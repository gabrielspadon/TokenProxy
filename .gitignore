# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/tests/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
**/coverage

# next.js
/.next/
**/.next/
/.next-cli-build/
/out/
cli/.build-home/
product
# production
/build
**/build
.idea/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.bin/*
/data/
# Anchored: an unanchored pattern matches at ANY depth, so it also hid the
# source directory src/app/api/usage/logs and a new file there would have been
# invisible to git add.
/logs/*
# This repository HAS a source directory named logs (src/app/api/usage/logs).
# A contributor whose global gitignore carries an unanchored `logs/` would
# find it invisible to git add, so un-ignore it here explicitly.
!src/app/api/usage/logs/
!src/app/api/usage/logs/**
/source/*
.cursor/*
# docs/ is ignored by default and each shipped page is un-ignored by name, so a
# scratch note dropped in here never reaches a commit by accident. A new page
# needs its own line below or git add will not see it.
docs/*
!docs/providers.md
!docs/troubleshooting.md
!docs/deployment.md
!docs/logging-design.md
# The design record ships with the repository: the written design system, the
# artboards behind the chosen direction, the verification suite and the
# captured evidence each gate is judged against. A gate that cannot be re-run
# from a clean checkout is not a gate.
!docs/design/
!docs/design/**
# The reconciliation record ships too: the frozen admin ABI, the redacted
# overlay specification, the per-capability issues, and the provenance receipt.
# A contract every later change is judged against cannot live in an ignored
# directory, or a clean checkout cannot re-derive what was agreed.
!docs/reconciliation/
!docs/reconciliation/**
# The route-level HTTP contracts the operator surface is wired against, and
# the prompt packet that hands a rebuild to an agent. Both are inputs a clean
# checkout must be able to reproduce the surface from.
!docs/contract/
!docs/contract/**
!docs/prompts/
!docs/prompts/**
test/*
open-sse/test/*
RM.vn.md
RM.md
cursor/*
PUBLIC.md
Thanks.md
PUBLIC.en.md
PR/*
package-lock.json


#Ignore vscode AI rules
.github/instructions/codacy.instructions.md
README1.md
deploy*.sh
ecosystem.config.*

scripts/agSniffer/*
gitbooks/*
gitbook/README.md

# Refactor backup reference (do not bundle/lint)
open-sse.old/
.graphifyignore
graphify-out/*

# Local-only working dirs (notes, vendored repos, scripts, skills)
.claude/
.docs/
.repo/
.script/
.codegraph/
.PR/
.next-analyze/*

# oh-my-claudecode local state
.omc/

# local tool state
.serena/

# unlazy stop-hook state (local, per-checkout)
.unlazy-hook-state.json

# Local-only: agent instructions, campaign state, development evidence and
# translated documentation. The repository ships English production docs only;
# the web UI's own multi-language support lives in public/i18n and src/i18n and
# is unaffected.
CLAUDE.md
PLAN.md
GATES.md
AGENTS.md
.claude/
.unlazy/
# Browser-automation scratch: baseline captures and console logs written during
# an audit run. The evidence that ships lives under docs/design/evidence/; this
# is the working directory that produced it and is regenerated on every run.
.playwright-mcp/
.vscode/
README.*.md
/i18n/
.local-explore/

# Second isolated verification build tree, produced by
# docs/design/verification/instance.sh alongside .next/. It is a build output
# like .next/ and is regenerated by the script, never edited.
/.next-r3/
# Screenshot scratch dropped at the repository root during a review pass. The
# evidence that ships lives under docs/design/evidence/; anchored so a product
# image committed deliberately inside public/ or src/ stays visible.
/*.png

# Build provenance stamp, written by cli/scripts/build-cli.js at pack time.
cli/BUILD_SHA

# packed CLI releases land here during local builds
/tokenproxy-*.tgz

# design evidence screenshots (regenerated by docs/design/scripts/evidence.mjs)
docs/design/evidence/**/*.png
/tests/test-results/

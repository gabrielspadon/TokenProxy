# TokenProxy environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/tokenproxy

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Optional 429 account/model lock backoff. Defaults retain the current schedule:
# 2s, 4s, 8s... capped at 5 minutes, with at most 15 backoff levels.
# Each value is optional and must be a positive integer. Invalid values use that
# knob's default; a max below the base is rejected as a complete schedule.
# BACKOFF_BASE_MS=2000
# BACKOFF_MAX_MS=300000
# BACKOFF_MAX_LEVEL=15

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Per-caller sliding-window rate limit on /v1 chat, keyed by API key else client
# IP. Both default when unset, non-numeric or non-positive. A multi-agent client
# fans subagents out over one key, so raise the ceiling rather than the window.
# RATE_LIMIT_MAX_REQUESTS=240
# RATE_LIMIT_WINDOW_MS=60000

# Optional: overrides the machine-derived key used to encrypt provider connection
# secrets (access/refresh tokens, API keys) at rest in the local SQLite DB.
# Set this if you need the DB to remain readable after moving DATA_DIR to a new machine.
# DB_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
# CLOUD_URL=
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_# CLOUD_URL=

# Firecrawl web fetch provider
# Leave FIRECRAWL_API_KEY empty to route to a self-hosted instance.
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_API_KEY=
FIRECRAWL_TIMEOUT_MS=30000
FIRECRAWL_DEFAULT_FORMAT=markdown

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
# ProxyAgent timeouts are read when each proxy URL's dispatcher is first created.
# PROXY_CONNECT_TIMEOUT_MS=90000
# PROXY_HEADERS_TIMEOUT_MS=300000
# Streaming body timeout stays disabled (0).

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# CodeBuddy CN replaces a system prompt that looks like a coding-agent identity,
# because Tencent's content filter rejects those requests. Prompts longer than
# this many characters are treated as agent prompts too; raise it if a long
# hand-written system prompt is being replaced, or set 0 to match on the
# identity markers alone. Default 2000.
# CODEBUDDY_SYSTEM_PROMPT_MAX_LEN=2000


# Headroom proxy compression (server-only; never expose in UI or API responses)
# URL of the compression proxy used by the token saver.
# HEADROOM_URL=http://localhost:8787
# Outbound compress-call timeout. Finite integer 0 < ms < 600000, else defaults to 30000.
# HEADROOM_TIMEOUT_MS=30000
# Outbound client secret sent as `Authorization: Bearer <key>` to the proxy. Trimmed.
# HEADROOM_API_KEY=
# Managed inbound secret: server-side config for the proxy this app spawns.
# The spawned child inherits the full process env (spawn env: { ...process.env }),
# so HEADROOM_PROXY_TOKEN stays inbound-only — it is NEVER sent outbound and is
# never a fallback when HEADROOM_API_KEY is missing. For managed-token auth set
# HEADROOM_PROXY_TOKEN and HEADROOM_API_KEY to the SAME value.
# HEADROOM_PROXY_TOKEN=

# Final response-header fallback when provider, registry or executor, and global settings are absent or invalid.
# FETCH_CONNECT_TIMEOUT_MS=60000

# Optional timeout tuning for Ollama Local provider (default: 120000ms).
# Increase if large models (e.g. 70B+) are slow to respond with first tokens.
# OLLAMA_LOCAL_CONNECT_TIMEOUT_MS=120000

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=tokenproxy
